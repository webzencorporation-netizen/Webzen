# ─────────────────────────────────────────────────────────────────────────────
# BotsSaaS — variáveis de ambiente
# Copie para `.env` e ajuste. NUNCA coloque segredos reais neste arquivo de exemplo.
# Em produção, providers "mock" são recusados na inicialização.
# ─────────────────────────────────────────────────────────────────────────────

# development | test | production
NODE_ENV=development
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# URL pública do painel (usada em links e verificação de Origin/CSRF)
APP_URL=http://localhost:3000
# URL pública da API (usada para exibir a URL do webhook para configurar na Meta)
API_PUBLIC_URL=http://localhost:4000
API_HOST=0.0.0.0
API_PORT=4000

# ── Infra ────────────────────────────────────────────────────────────────────
# PostgreSQL 16+ (docker compose up -d  OU  pnpm services:local)
DATABASE_URL=postgresql://botsaas:botsaas@localhost:5432/botsaas
# Banco usado pelos testes de integração (é recriado pelos testes!)
TEST_DATABASE_URL=postgresql://botsaas:botsaas@localhost:5432/botsaas_test
REDIS_URL=redis://localhost:6379

# ── Segurança ────────────────────────────────────────────────────────────────
# Chave AES-256-GCM (32 bytes em base64) para criptografar tokens de integrações.
# Gere com: openssl rand -base64 32   (obrigatória em produção)
ENCRYPTION_KEY=
# Duração da sessão de login (dias)
SESSION_TTL_DAYS=14
# Força cookie Secure (padrão: true em produção, false em dev)
COOKIE_SECURE=
# Limite global de requisições por IP por minuto
RATE_LIMIT_PER_MINUTE=300
# Tentativas de login por IP por minuto
LOGIN_RATE_LIMIT_PER_MINUTE=10

# ── IA (Anthropic Claude) ────────────────────────────────────────────────────
# anthropic | mock   (mock: respostas determinísticas para desenvolvimento/testes)
AI_PROVIDER=mock
ANTHROPIC_API_KEY=
# Modelo padrão quando a empresa não define um. Consulte a documentação atual da Anthropic.
AI_DEFAULT_MODEL=claude-opus-5
# Modelo usado para resumos de conversa (opcional; padrão = AI_DEFAULT_MODEL)
AI_SUMMARY_MODEL=
# Reexecuta automaticamente em modelo alternativo se o classificador de segurança recusar (fallbacks: "default")
AI_REFUSAL_FALLBACK=true
AI_REQUEST_TIMEOUT_MS=120000

# ── WhatsApp (Meta WhatsApp Business Platform — Cloud API oficial) ──────────
# cloud | mock   (mock: não envia nada; mensagens aparecem só no painel)
WHATSAPP_PROVIDER=mock
# Versão da Graph API (verifique a versão atual em developers.facebook.com/docs/graph-api/changelog)
WHATSAPP_GRAPH_API_VERSION=v25.0
WHATSAPP_GRAPH_API_BASE_URL=https://graph.facebook.com
# App Secret do app Meta — usado para validar X-Hub-Signature-256 dos webhooks
WHATSAPP_APP_SECRET=
# String escolhida por você e cadastrada no painel da Meta para verificar o webhook
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# Reservado para o Embedded Signup (conexão self-service de números — fase futura)
META_APP_ID=
META_EMBEDDED_SIGNUP_CONFIG_ID=

# ── Armazenamento de mídias e documentos ────────────────────────────────────
# local | s3   (s3 funciona com AWS S3, Cloudflare R2, MinIO e compatíveis)
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./storage
S3_BUCKET=
S3_REGION=auto
# Ex.: R2 → https://<account>.r2.cloudflarestorage.com
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
# Tamanho máximo de upload (bytes)
UPLOAD_MAX_BYTES=16777216

# ── Transcrição de áudio ────────────────────────────────────────────────────
# none | mock | openai-compatible
# A API da Claude não transcreve áudio; use um serviço compatível com /audio/transcriptions.
STT_PROVIDER=none
# Ex.: https://api.openai.com/v1/audio/transcriptions
STT_API_URL=
STT_API_KEY=
STT_MODEL=

# ── Google Calendar (OAuth) ─────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Ex.: http://localhost:4000/api/integrations/google/callback
GOOGLE_REDIRECT_URI=

# ── Seed (somente desenvolvimento) ──────────────────────────────────────────
SEED_ADMIN_EMAIL=admin@plataforma.local
# Se vazio, o seed usa uma senha de desenvolvimento e a imprime no terminal.
SEED_ADMIN_PASSWORD=
