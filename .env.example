# ─────────────────────────────────────────────────────────────────────────────
# BotsSaaS — variáveis de ambiente
# Copie para `.env` e ajuste. NUNCA coloque segredos reais neste arquivo de exemplo.
# Em produção, providers "mock" são recusados na inicialização.
# ─────────────────────────────────────────────────────────────────────────────

# development | test | production
NODE_ENV=development
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# URL pública do painel (usada em links e verificação de Origin/CSRF)
APP_URL=http://localhost:3000
# URL pública da API (usada para exibir a URL do webhook para configurar na Meta)
API_PUBLIC_URL=http://localhost:4000
API_HOST=0.0.0.0
API_PORT=4000

# ── Infra ────────────────────────────────────────────────────────────────────
# PostgreSQL 16+ (docker compose up -d  OU  pnpm services:local)
DATABASE_URL=postgresql://botsaas:botsaas@localhost:5432/botsaas
# Banco usado pelos testes de integração (é recriado pelos testes!)
TEST_DATABASE_URL=postgresql://botsaas:botsaas@localhost:5432/botsaas_test
REDIS_URL=redis://localhost:6379

# ── Segurança ────────────────────────────────────────────────────────────────
# Chave AES-256-GCM (32 bytes em base64) para criptografar tokens de integrações.
# Gere com: openssl rand -base64 32   (obrigatória em produção)
ENCRYPTION_KEY=
# Duração da sessão de login (dias)
SESSION_TTL_DAYS=14
# Força cookie Secure (padrão: true em produção, false em dev)
COOKIE_SECURE=
# Limite global de requisições por IP por minuto
RATE_LIMIT_PER_MINUTE=300
# Tentativas de login por IP por minuto
LOGIN_RATE_LIMIT_PER_MINUTE=10
# Tentativas de login por CONTA a cada 15 min, de qualquer IP (força bruta distribuída)
LOGIN_ACCOUNT_MAX_ATTEMPTS=10
# Mensagens do "Testar agente" (IA paga) por empresa por minuto
AI_TEST_RATE_LIMIT_PER_MINUTE=20
# Proxies confiáveis para ler o IP real (X-Forwarded-For): nº de saltos (ex.: 1) ou IPs/CIDRs.
# Vazio = nenhum. NÃO use true (qualquer um poderia forjar o IP e burlar os limites).
TRUST_PROXY=

# ── IA (Anthropic Claude ou Meta Muse Spark) ─────────────────────────────────
# anthropic | meta | mock   (mock: respostas determinísticas para desenvolvimento/testes)
AI_PROVIDER=mock
# Obrigatória com AI_PROVIDER=anthropic. Gere em platform.claude.com → API Keys. Nunca versione.
ANTHROPIC_API_KEY=
# Obrigatória com AI_PROVIDER=meta. Gere em dev.meta.ai → API keys. Nunca versione.
META_MODEL_API_KEY=
# Endpoint da Meta Model API compatível com a Messages API (vazio = https://api.meta.ai)
META_MODEL_API_BASE_URL=
# Modelo padrão quando a empresa não define um; deve ser do provedor ativo
# (anthropic: ex. claude-opus-5 · meta: muse-spark-1.3). Consulte a documentação atual.
AI_DEFAULT_MODEL=claude-opus-5
# Modelo usado para resumos de conversa (opcional; padrão = AI_DEFAULT_MODEL)
AI_SUMMARY_MODEL=
# Reexecuta automaticamente em modelo alternativo se o classificador de segurança recusar (fallbacks: "default",
# beta server-side-fallback-2026-07-01; só para claude-opus-5, claude-opus-5-5, claude-fable-5 e claude-fable-5-1).
# Use false para homologar primeiro a chamada básica.
AI_REFUSAL_FALLBACK=true
# Timeout por requisição à Anthropic (ms); o SDK ainda faz até 2 retentativas.
AI_REQUEST_TIMEOUT_MS=120000
# Homologação com credencial real (chamadas pequenas e pagas): pnpm homolog:anthropic [--cache]
# ou, com AI_PROVIDER=meta: pnpm homolog:meta

# ── WhatsApp (Meta WhatsApp Business Platform — Cloud API oficial) ──────────
# cloud | mock   (mock: não envia nada; mensagens aparecem só no painel)
WHATSAPP_PROVIDER=mock
# Versão da Graph API. v25.0 é suportada até 2028-07-29; a atual é v26.0 (2026-07-29).
# Homologue com v26.0 antes de trocar (developers.facebook.com/docs/graph-api/changelog).
WHATSAPP_GRAPH_API_VERSION=v25.0
WHATSAPP_GRAPH_API_BASE_URL=https://graph.facebook.com
# App Secret do app Meta — usado para validar X-Hub-Signature-256 dos webhooks
WHATSAPP_APP_SECRET=
# String escolhida por você e cadastrada no painel da Meta para verificar o webhook
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# Preço por mensagem cobrável (USD) por categoria de cobrança da Meta, em JSON. Complementa a
# referência do código (service/utility/authentication = 0.0068, Brasil). Confira a tabela vigente.
# Ex.: WHATSAPP_PRICE_USD={"marketing":0.0625}
WHATSAPP_PRICE_USD=
# Homologação (pnpm homolog:whatsapp): token de System User e IDs do número/WABA de TESTE.
# Usados só pelo script; tokens de produção ficam criptografados no banco, por número.
HOMOLOG_WA_ACCESS_TOKEN=
HOMOLOG_WA_PHONE_NUMBER_ID=
HOMOLOG_WA_WABA_ID=
# Reservado para o Embedded Signup (conexão self-service de números — fase futura)
META_APP_ID=
META_EMBEDDED_SIGNUP_CONFIG_ID=

# ── Armazenamento de mídias e documentos ────────────────────────────────────
# local | s3   (s3 funciona com AWS S3, Cloudflare R2, MinIO e compatíveis)
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./storage
S3_BUCKET=
S3_REGION=auto
# Ex.: R2 → https://<account>.r2.cloudflarestorage.com
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
# Tamanho máximo de upload (bytes)
UPLOAD_MAX_BYTES=16777216

# ── Transcrição de áudio ────────────────────────────────────────────────────
# none | mock | openai-compatible
# A API da Claude não transcreve áudio; use um serviço compatível com /audio/transcriptions.
STT_PROVIDER=none
# Ex.: https://api.openai.com/v1/audio/transcriptions
STT_API_URL=
STT_API_KEY=
STT_MODEL=

# ── Google Calendar (OAuth) ─────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Ex.: http://localhost:4000/api/integrations/google/callback
GOOGLE_REDIRECT_URI=

# ── Cobrança (Stripe) ───────────────────────────────────────────────────────
# IDs oficiais dos preços na Stripe (price_...), por plano e período. Use os do modo teste
# em desenvolvimento/homologação e os de produção só em produção. O seed de referência grava
# estes IDs nos planos; o administrador também pode editá-los no painel da plataforma.
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_STARTER_YEARLY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_BUSINESS_MONTHLY=
STRIPE_PRICE_BUSINESS_YEARLY=

# ── Seed (somente desenvolvimento) ──────────────────────────────────────────
SEED_ADMIN_EMAIL=admin@plataforma.local
# Se vazio, o seed usa uma senha de desenvolvimento e a imprime no terminal.
SEED_ADMIN_PASSWORD=
