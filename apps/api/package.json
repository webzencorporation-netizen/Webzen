{
  "name": "@botsaas/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/main.ts",
    "dev:worker": "tsx watch --env-file-if-exists=../../.env src/worker.ts",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "bootstrap:owner": "tsx src/bootstrap-owner.ts",
    "start:bootstrap-owner": "node dist/bootstrap-owner.js",
    "build": "tsx scripts/build.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:build": "tsx scripts/check-build.ts",
    "homolog:anthropic": "tsx --env-file-if-exists=../../.env scripts/homolog-anthropic.ts",
    "homolog:whatsapp": "tsx --env-file-if-exists=../../.env scripts/homolog-whatsapp.ts",
    "homolog:meta": "tsx --env-file-if-exists=../../.env scripts/homolog-meta.ts",
    "test:watch": "vitest",
    "seed": "tsx --env-file-if-exists=../../.env src/seed/run.ts",
    "stripe:forward": "tsx --env-file-if-exists=../../.env scripts/stripe-forward.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@aws-sdk/client-s3": "^3.1141.0",
    "@botsaas/ai": "workspace:*",
    "@botsaas/config": "workspace:*",
    "@botsaas/database": "workspace:*",
    "@botsaas/integrations": "workspace:*",
    "@botsaas/shared": "workspace:*",
    "@botsaas/whatsapp": "workspace:*",
    "@date-fns/tz": "^1.5.0",
    "@fastify/cookie": "^11.1.2",
    "@fastify/helmet": "^13.1.1",
    "@fastify/multipart": "^10.1.2",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/swagger": "^9.9.0",
    "@node-rs/argon2": "^2.2.1",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "bullmq": "^6.3.9",
    "date-fns": "^4.4.0",
    "fastify": "^5.12.5",
    "fastify-plugin": "^6.0.0",
    "fastify-type-provider-zod": "^7.0.0",
    "ioredis": "^5.8.2",
    "nodemailer": "^10.0.13",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "stripe": "^22.6.2",
    "unpdf": "^1.8.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "dotenv": "^18.0.4",
    "esbuild": "^0.28.2",
    "pino-pretty": "^13.1.3",
    "vitest": "^5.0.2"
  }
}
